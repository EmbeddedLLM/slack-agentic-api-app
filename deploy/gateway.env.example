# Copy to .env.gateway. Read by the combined app launcher and gateway:start.
# Search provider credentials belong to the gateway, not the Slack app.
YOU_API_KEY=
YOU_API_BASE_URL=https://ydc-index.io
AGENTIC_WEB_SEARCH_PROVIDER=you
AGENTIC_CODE_INTERPRETER_ENABLED=true
LLM_API_BASE=http://127.0.0.1:5050
GATEWAY_HOST=127.0.0.1
GATEWAY_PORT=9000
RUST_LOG=info
# Seconds allowed while waiting for upstream headers or the next streamed chunk.
# Separate from the Slack client total timeout, AGENTIC_TIMEOUT_MS in .env.
STREAMING_CHUNK_TIMEOUT_S=600
# Optional: move both the database and uploaded files to a persistent volume.
# AGENTIC_API_HOME=/absolute/path/to/gateway-data
