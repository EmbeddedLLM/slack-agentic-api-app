# Slack Socket Mode. These tokens are never sent to Agentic API.
SLACK_BOT_TOKEN=
SLACK_APP_TOKEN=

# Agentic API WebSocket endpoint, including /v1/responses.
# Use wss:// when connecting across an untrusted network.
AGENTIC_WS_URL=ws://127.0.0.1:9000/v1/responses
# Exact ID of the tool-capable model served behind the gateway.
AGENTIC_MODEL=Qwen/Qwen3.8-27B-FP8
# Optional bearer credential for the gateway's WebSocket upgrade (e.g. OIDC token).
AGENTIC_API_KEY=
AGENTIC_TIMEOUT_MS=180000
AGENTIC_MAX_OUTPUT_TOKENS=8192
# Must not exceed the gateway's request body/frame limit. Includes base64 images.
AGENTIC_MAX_REQUEST_BYTES=10485760

# Gateway-owned tools: web_search and code_interpreter.
# Interpreter must also be built and enabled on the gateway.
# Empty disables search. Search provider credentials belong on the gateway.
AGENTIC_TOOLS=web_search
AGENTIC_TOOLS_TRUSTED=web_search,code_interpreter
# `multi <task>` additionally requires multiAgent:true in the user's role.
AGENTIC_MULTI_AGENT_ENABLED=true
AGENTIC_MAX_CONCURRENT_SUBAGENTS=3
# Optional file_search: add it to a role's tools and set vectorStoreIds there,
# or supply shared default store IDs here. Obtain IDs with npm run knowledge.
# AGENTIC_VECTOR_STORE_IDS=vs_your_store
# Native input_file for bounded extracted UTF-8 text; false uses inline prompt text.
AGENTIC_NATIVE_FILE_INPUTS=true
# Optional custom role tools are set in access.json.
ACCESS_FILE=./access.json
# Keep persistent: prevents bot-to-bot reply limits resetting on restart.
BOT_PEER_STATE_DIR=./data/bot-peers
# Local response pointers; set empty to disable persistent chat memory.
AGENTIC_SESSION_DIR=./data/sessions

MAX_CONCURRENT_JOBS=2
MAX_JOBS_PER_USER=2
HISTORY_LIMIT=50
CONTEXT_CHAR_BUDGET=24000
PER_MESSAGE_CHAR_LIMIT=3000
THREAD_FOLLOW=false
THREAD_FOLLOW_TTL_HOURS=72
# BOT_DISPLAY_NAME=assistant
HINTS_FILE=./data/hints.json

SLACK_MARKDOWN_BLOCKS=false
SLACK_REACTIONS=true
REPLY_FILE_THRESHOLD=12000
MAX_FILES_PER_REPLY=3
MAX_FILE_BYTES=10000000
# Local animated GIF function, available to roles with createFiles:true.
STICKERS_ENABLED=true
# Optional PDF renderer requires Chromium. Keep its sandbox enabled.
PDF_NO_SANDBOX=false
MAX_INPUT_FILES=5
MAX_INPUT_FILE_BYTES=20000000
MAX_INPUT_IMAGES=8
ATTACHMENT_CHAR_BUDGET=40000
# INPUT_FILES_DIR=/tmp/slack-agentic-inputs

# An approved plan runs as several WebSocket Responses requests with web_search.
RESEARCH_TIMEOUT_MS=3600000
RESEARCH_MAX_CONCURRENT=1
# Use gateway subagents for roles with multiAgent:true; redeclared on every turn.
RESEARCH_MULTI_AGENT=true
RESEARCH_DIR=./data/research
RESEARCH_KEEP_DAYS=30

# Optional JSON files with key/token/secret values to redact from Slack output.
# REDACT_SECRET_FILES=/etc/slack-agentic/extra-secrets.json
# REDACT_PATHS=/etc/slack-agentic
